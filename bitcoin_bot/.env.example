# ═══════════════════════════════════════════════════
#  BTC Scalping Bot — Variables de entorno
# ═══════════════════════════════════════════════════
#  IMPORTANTE: Copiar este archivo a ".env" y rellenar
#  NUNCA subir el archivo .env real a git
# ═══════════════════════════════════════════════════

# ── Binance Testnet (paper trading — sin dinero real) ──
# Obtener en: https://testnet.binance.vision/
BINANCE_TESTNET_KEY=tu_testnet_api_key_aqui
BINANCE_TESTNET_SECRET=tu_testnet_api_secret_aqui

# ── Binance Real (SOLO PARA MODO LIVE — NO ACTIVAR AÚN) ──
# El bot arranca siempre en PAPER MODE.
# Para activar modo real, es necesario cambiar paper.enabled=False
# en config.py Y proporcionar estas claves.
BINANCE_API_KEY=
BINANCE_SECRET=

# ── Logging ──────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
